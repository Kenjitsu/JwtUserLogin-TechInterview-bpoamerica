@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-lg border-0 rounded-4 border-top border-primary border-5">
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <h3 class="fw-bolder mb-0">User Dashboard</h3>
                        <p class="text-muted small">Account information overview</p>
                    </div>
                    <div class="alert alert-success border-0 shadow-sm rounded-3 text-center mb-3 fw-medium py-2">
                        Successful login!
                    </div>
                    <form>
                        <div class="form-floating mb-2">
                            <input asp-for="IdUser" class="form-control bg-body-tertiary border-0 fw-semibold text-secondary" placeholder="IdUser" readonly />
                            <label class="text-muted">IdUser</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input asp-for="UserName" class="form-control bg-body-tertiary border-0 fw-semibold text-secondary" placeholder="UserName" readonly />
                            <label class="text-muted">UserName</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input asp-for="UserProfile" class="form-control bg-body-tertiary border-0 fw-semibold text-secondary" placeholder="UserProfile" readonly />
                            <label class="text-muted">UserProfile</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="LastLoginDate" class="form-control bg-body-tertiary border-0 fw-semibold text-secondary" placeholder="LastLoginDate" readonly />
                            <label class="text-muted">LastLoginDate</label>
                        </div>

                        <hr class="my-3 text-muted opacity-25">

                        <div class="text-center">
                            <a asp-page="/Logout" class="btn btn-outline-danger btn-lg w-100 py-2 fw-bold shadow-sm rounded-3">
                                Log out
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
