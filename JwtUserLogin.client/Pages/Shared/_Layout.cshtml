<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Tech test</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JwtUserLogin.client.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white shadow-sm py-2">
                <div class="container">
                    <a class="navbar-brand fw-bolder text-primary" asp-area="" asp-page="/Index">Login user tech test</a>

                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-toggle="target=" .navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                        </ul>
                        <div class="d-flex align-items-center">
                            <span class="text-muted small fw-medium">Hola, @User.Identity.Name</span>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container flex-grow-1 d-flex align-items-center justify-content-center py-3">
        <main role="main" class="w-100">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <footer class="bg-white text-center text-muted small py-3 shadow-sm mt-auto">
            <div class="container">
                &copy; 2026 - Login user tech test
                - <span class="fw-medium">Ricardo Corredor</span>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
